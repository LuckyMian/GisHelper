# 虚拟环境
.venv/
venv/
env/

# Python 缓存
__pycache__/
*.py[cod]
*.egg-info/
.eggs/

# 打包产物
build/
dist/
*.spec
!build_tools/*.spec

# pip 安装过程中的临时目录（TEMP 指向工作区时会残留）
pip-build-env-*/
pip-build-tracker-*/
pip-install-*/
pip-ephem-wheel-cache-*/

# 工具缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# 本地配置
.env
.env.*
!.env.example
.vscode/*.log

# 系统文件
Thumbs.db
Desktop.ini
.DS_Store

# GIS 数据 / 临时输出（按需保留）
*.tif
*.tiff
*.mbtiles
!tests/fixtures/**
output/
tmp/

# 平台元数据与本地缓存
.multica/
.agent_context/
gismapshelper-ezdxf-cache/
